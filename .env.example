# 8BALL PRO Environment Configuration

# Optional external real-time multiplayer backend (Firebase / Supabase / WebSocket)
# If left empty, the game uses high-performance local client-side persistence (localStorage)
# with instant 4-player AI matchmaking and Room/Browser simulation.
VITE_ENABLE_ONLINE_BACKEND=false
VITE_BACKEND_API_URL=https://api.8ballpro.example.com
VITE_WEBSOCKET_SERVER=wss://ws.8ballpro.example.com
